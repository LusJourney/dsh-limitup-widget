# =============================================================================
# A股涨停直播看板 — 部署环境变量示例
#
# 使用：cp .env.example .env    然后按需修改 .env（不要提交 .env 到 git）
# 修改后执行 ./deploy.sh up（或 ./deploy.sh restart）生效。
# =============================================================================

# ---- 容器内监听（Docker 部署请保持 0.0.0.0，否则反向代理访问不到）----
HOST=0.0.0.0
PORT=8000

# 时区：页面所有时间按北京时间展示；容器内也靠它决定日志时间
TZ=Asia/Shanghai

# ---- 公网访问 ----
# 访问域名（如 limitup.example.com）。
#   - 留空：仅 http://<服务器公网IP>/ 明文访问（无 HTTPS）
#   - 填写：Caddy 自动申请并续期 Let's Encrypt 证书
#     （前提：域名 A 记录已指向本机；安全组放行 22/80/443；国内服务器需完成 ICP 备案）
DOMAIN=

# 反向代理站点地址，由 deploy.sh 按 DOMAIN 自动推导，一般无需手改：
#   有 DOMAIN -> https://<domain> ；无 DOMAIN -> :80
SITE_ADDRESS=:80

# 对外暴露端口（一般不用改；改了要同时确认云安全组/防火墙放行）
# HTTP_PORT=80
# HTTPS_PORT=443

# =============================================================================
# 可选安全加固（访问码/限流默认关闭；留空 = 不改变行为）
# 需要仓库最新版 app.py 支持（当前仓库版本已支持；更旧版本会忽略这些变量，不报错）。
# =============================================================================
# 访问码：设置后访问需带访问码。首次用 http://<域名>/?code=你的访问码 打开，
# 之后由 HttpOnly Cookie 记住（30 天）；/api/health 始终放行（健康检查用）。
LIMITUP_ACCESS_CODE=
# 每 IP 每分钟请求上限（0/留空 = 不限）。启用后务必保留 LIMITUP_TRUST_PROXY=1，
# 否则所有请求在 app 眼里都来自反向代理，限流会变成"全局共用一个名额"。
LIMITUP_RATE_LIMIT=
# 位于 Caddy/nginx 之后：信任反向代理注入的 X-Forwarded-For（取真实客户端 IP）。
# 仅当 app 没有被直接暴露到公网时安全 —— compose 默认不发布 8000 端口，请勿改成直连。
LIMITUP_TRUST_PROXY=1
# /api/refresh（页面"刷新"按钮）的每 IP 冷却秒数，默认 10；0=不限制
# LIMITUP_REFRESH_COOLDOWN=10
